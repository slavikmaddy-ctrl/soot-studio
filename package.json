  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node --check server.js && node --check js/main.js",
    "start": "node --env-file-if-exists=.env server.js"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "express": "^5.1.0",
    "pg": "^8.13.0"
  }
}
